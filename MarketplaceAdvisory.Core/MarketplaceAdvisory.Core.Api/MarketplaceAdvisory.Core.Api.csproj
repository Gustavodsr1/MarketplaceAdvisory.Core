<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Core API: composition root and HTTP surface (Controllers).
       Validates JWTs issued by the Security provider and exposes business endpoints. -->

  <ItemGroup>
    <ProjectReference Include="..\MarketplaceAdvisory.Core.Application\MarketplaceAdvisory.Core.Application.csproj" />
    <ProjectReference Include="..\MarketplaceAdvisory.Core.Infrastructure\MarketplaceAdvisory.Core.Infrastructure.csproj" />
    <ProjectReference Include="..\..\MarketplaceAdvisory.Aspire\MarketplaceAdvisory.ServiceDefaults\MarketplaceAdvisory.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\MarketplaceAdvisory.Shared\MarketplaceAdvisory.Contracts\MarketplaceAdvisory.Contracts.csproj" />
    <ProjectReference Include="..\..\MarketplaceAdvisory.Shared\MarketplaceAdvisory.SharedKernel\MarketplaceAdvisory.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Asp.Versioning.Mvc" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <PackageReference Include="AspNetCore.HealthChecks.Redis" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.Seq" />
    <!-- Typed client used to call the Security provider (fetch/validate tokens) -->
    <PackageReference Include="Refit" />
    <PackageReference Include="Refit.HttpClientFactory" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <!-- Design-time only: enables `dotnet ef` with this project as startup -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
